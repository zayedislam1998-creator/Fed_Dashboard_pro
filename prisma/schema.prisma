model CommunicationConversation {
  id                     String                 @id
  conversationKey        String                 @unique @map("conversation_key")
  participant1Id         String                 @map("participant1_id")
  participant1Name       String                 @map("participant1_name")
  participant1Role       String                 @map("participant1_role")
  participant1AvatarUrl  String?                @map("participant1_avatar_url")
  participant2Id         String                 @map("participant2_id")
  participant2Name       String                 @map("participant2_name")
  participant2Role       String                 @map("participant2_role")
  participant2AvatarUrl  String?                @map("participant2_avatar_url")
  lastMessageText        String                 @default("") @map("last_message_text")
  lastMessageTimestampMs BigInt                 @default(0) @map("last_message_timestamp_ms")
  unreadCountP1          Int                    @default(0) @map("unread_count_p1")
  unreadCountP2          Int                    @default(0) @map("unread_count_p2")
  isPinned               Boolean                @default(false) @map("is_pinned")
  createdAt              String                 @map("created_at")
  updatedAt              String                 @map("updated_at")
  timestampMs            BigInt                 @map("timestamp_ms")
  extraFields            Json                   @default("{}") @map("extra_fields")
  messages               CommunicationMessage[]

  @@index([participant1Id, lastMessageTimestampMs])
  @@index([participant2Id, lastMessageTimestampMs])
  @@map("communication_conversations")
}

model CommunicationMessage {
  id              String                    @id
  conversationId  String                    @map("conversation_id")
  senderId        String                    @map("sender_id")
  senderName      String                    @map("sender_name")
  senderRole      String                    @map("sender_role")
  senderAvatarUrl String?                   @map("sender_avatar_url")
  recipientId     String                    @map("recipient_id")
  text            String
  attachments     Json                      @default("[]") @map("attachments")
  status          String                    @default("SENT") @map("status")
  isRead          Boolean                   @default(false) @map("is_read")
  readAt          String?                   @map("read_at")
  replyToId       String?                   @map("reply_to_id")
  replySnippet    String?                   @map("reply_snippet")
  reactions       Json                      @default("{}") @map("reactions")
  isPinned        Boolean                   @default(false) @map("is_pinned")
  createdAt       String                    @map("created_at")
  timestampMs     BigInt                    @map("timestamp_ms")
  extraFields     Json                      @default("{}") @map("extra_fields")
  conversation    CommunicationConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, timestampMs])
  @@index([recipientId, isRead])
  @@map("communication_messages")
}

