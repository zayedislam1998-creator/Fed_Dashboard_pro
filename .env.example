# PostgreSQL Connection (Required for persistent VPS deployment)
DATABASE_URL="postgresql://postgres:password@localhost:5432/workspace_pro?schema=public"

# Server & Runtime
NODE_ENV=production
PORT=3000

# Initial Administrator Identity (configured server-side only; no public setup UI)
ADMIN_NAME=Administrator
ADMIN_USERNAME=zayed.islam1998@gmail.com
ADMIN_PASSWORD=

# Persistent Binary Storage Path on VPS (defaults to ./storage if writable)
EXTERNAL_STORAGE_DIR=./storage

# Master Encryption Key for AES-256-GCM Mail Credentials (set a fixed 32+ char secret on VPS)
WORKSPACE_MASTER_KEY=

# Optional: Direct pg.Pool tuning
PG_POOL_MAX=15
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=10000